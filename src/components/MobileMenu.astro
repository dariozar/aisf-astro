---
import { Button } from "@/components/starwind/button";
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetHeader,
  SheetTitle,
} from "@/components/starwind/sheet";
import { NAV_LINKS } from "../lib/nav";
---

{/* Rendered at body level: SheetContent uses position:fixed, which would be
    trapped by the nav's backdrop-filter if nested inside it. */}
<Sheet id="mobile-menu">
  <SheetContent side="right" class="border-rule-light bg-paper">
    <SheetHeader>
      <SheetTitle>
        <span class="inline-block rounded-[12px] bg-paper px-2.5 py-1.5">
          <img src="/aisf-logo.png" alt="AISF" class="h-8 w-auto" />
        </span>
      </SheetTitle>
    </SheetHeader>
    <div class="flex flex-col px-4">
      {NAV_LINKS.map((l) => (
        <SheetClose asChild>
          <a href={l.href} class="-mx-3 rounded-[10px] px-3 py-2.5 font-display text-lg font-medium text-ink no-underline hover:bg-paper-2">
            {l.label}
          </a>
        </SheetClose>
      ))}
    </div>
    <div class="px-4 pb-4">
      <SheetClose asChild>
        <Button href="/unisciti" variant="primary" class="w-full">Iscriviti &rarr;</Button>
      </SheetClose>
    </div>
  </SheetContent>
</Sheet>
