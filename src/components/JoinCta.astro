---
import Tag from "./Tag.astro";
import { Button } from "./starwind/button";
---

<section id="join" class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-20">
  <div
    class="rounded-[28px] px-6 py-16 text-center"
    style="background: linear-gradient(160deg, #F4D8DE 0%, #F4B8C2 50%, #E8A0AE 100%)"
  >
    <Tag>07 &mdash; Unisciti</Tag>
    <h2 class="mx-auto mt-3 max-w-[20ch] font-display text-[clamp(28px,4vw,44px)] leading-[1.05] font-semibold tracking-[-0.02em]">
      La fisica è meglio <span class="font-serif font-normal italic">insieme.</span>
    </h2>
    <p class="mx-auto mt-3 max-w-[52ch] text-[16px] leading-[1.55]">
      Trova il comitato del tuo ateneo — o avviane uno nuovo con il nostro supporto.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <Button href="/comitati">Trova il tuo comitato &rarr;</Button>
      <Button href="mailto:info@ai-sf.it" variant="outline">Scrivici</Button>
    </div>
  </div>
</section>
