---
import { getCollection } from "astro:content";
import Eyebrow from "./Eyebrow.astro";
import ItalyMap from "./ItalyMap.astro";

const committees = await getCollection("committees");
const active = committees.filter((c) => c.data.status !== "frozen");
---

<section class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-20">
  <Eyebrow>Comitati locali</Eyebrow>
  <h2 class="mt-3 font-display text-[clamp(28px,4vw,40px)] font-semibold tracking-[-0.015em]">
    {active.length} comitati, una rete.
  </h2>
  <div class="mt-8 grid grid-cols-1 items-center gap-8 min-[900px]:grid-cols-2">
    <ItalyMap committees={committees.map((c) => ({ id: c.id, name: c.data.name, status: c.data.status }))} linkBase="/comitati" />
    <div>
      <p class="max-w-[46ch] text-[16px] leading-[1.6] text-ink-soft">
        Da Torino a Palermo, ogni comitato organizza seminari, gruppi di studio e aperitivi scientifici
        nel proprio ateneo — coordinati a livello nazionale ma autonomi nel programma.
      </p>
      <p class="mt-4 font-display text-[15px] font-medium">
        {active.map((c) => c.data.name).join(" · ")}
      </p>
      <a href="/comitati" class="mt-5 inline-block font-display text-sm font-medium text-ink underline underline-offset-[6px]">
        Tutti i comitati &rarr;
      </a>
    </div>
  </div>
</section>
