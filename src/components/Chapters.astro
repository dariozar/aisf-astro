---
import { getCollection } from "astro:content";
import Tag from "./Tag.astro";
import { Card } from "./starwind/card";

const committees = (await getCollection("committees")).slice(0, 8);
const total = (await getCollection("committees")).length;
---

<section class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-20">
  <Tag>04 &mdash; Comitati locali</Tag>
  <h2 class="mt-2 font-display text-[clamp(28px,4vw,40px)] font-semibold tracking-[-0.015em]">
    {total} comitati, una rete.
  </h2>
  <div class="mt-8 grid grid-cols-1 gap-5 min-[900px]:grid-cols-[1fr_1fr]">
    <div class="rounded-[22px] border border-dashed border-ink/20 bg-paper-2 p-6">
      <img src="/italy-map.svg" alt="Mappa dei comitati AISF in Italia" class="mx-auto max-h-[420px]" />
    </div>
    <div class="flex flex-col gap-3">
      {committees.map((c) => (
        <Card class="border-rule-light bg-paper px-5 py-4">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-display text-[18px] font-semibold">{c.data.name}</h3>
            <span class="font-mono text-[11px] tracking-[0.08em] text-tangerine uppercase">{c.data.president}</span>
          </div>
        </Card>
      ))}
      <a href="/comitati" class="mt-2 font-display text-sm font-medium text-ink underline underline-offset-[6px]">
        Vedi tutti i {total} comitati &rarr;
      </a>
    </div>
  </div>
</section>
