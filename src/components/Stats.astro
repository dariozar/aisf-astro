---
import { getCollection } from "astro:content";
import Eyebrow from "./Eyebrow.astro";

const committees = await getCollection("committees");
const events = await getCollection("events");
const years = new Date().getFullYear() - 2014;

const stats = [
  { num: "1.400+", label: "Studenti nella rete" },
  { num: String(committees.length), label: "Comitati locali" },
  { num: String(events.length), label: "Eventi in archivio" },
  { num: String(years), label: "Anni di attività" },
];
---

<section class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-10">
  <div data-dark class="rounded-[28px] bg-ink px-[clamp(20px,4vw,48px)] py-[clamp(32px,5vw,56px)] text-paper">
    <Eyebrow dark>I numeri</Eyebrow>
    <div class="mt-6 grid grid-cols-2 gap-8 min-[900px]:grid-cols-4">
      {stats.map((s) => (
        <div>
          <p class="font-display font-semibold text-tangerine" style="font-size: clamp(40px, 6vw, 64px); line-height: 1;">
            {s.num}
          </p>
          <p class="mt-2 font-mono text-[11px] tracking-[0.12em] text-paper/60 uppercase">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
