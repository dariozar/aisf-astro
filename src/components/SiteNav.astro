---
import { Button } from "./starwind/button";

const links = [
  { label: "Chi siamo", href: "/chi-siamo" },
  { label: "Eventi", href: "/eventi" },
  { label: "Progetti", href: "/#projects" },
  { label: "Comitati", href: "/comitati" },
  { label: "Documenti", href: "/documenti" },
];
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-100 transition-all duration-300">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-[clamp(16px,4vw,32px)] py-4">
    <a href="/" aria-label="AISF home" class="flex items-center gap-2.5">
      <img src="/aisf-logo.png" alt="AISF" class="w-[clamp(36px,4.5vw,48px)]" />
      <span class="font-display text-[20px] font-semibold tracking-[-0.01em] text-ink" data-wordmark>AISF</span>
    </a>
    <div class="hidden items-center gap-[clamp(16px,2.2vw,28px)] min-[1100px]:flex" data-nav-links>
      {links.map((l) => (
        <a href={l.href} class="font-display text-[15px] text-ink no-underline">{l.label}</a>
      ))}
    </div>
    <div class="flex items-center gap-3">
      <p class="hidden font-mono text-[11px] tracking-[0.1em] text-ink-soft uppercase min-[1100px]:block" data-lang>
        <strong>IT</strong> &middot; EN
      </p>
      <Button href="/unisciti" size="sm" class="max-[720px]:hidden">Iscriviti &rarr;</Button>
      <button
        id="nav-toggle"
        class="hidden size-11 items-center justify-center rounded-full border border-ink/15 bg-paper/70 max-[1100px]:inline-flex"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Apri il menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="17" y2="6"></line>
          <line x1="3" y1="10" x2="17" y2="10"></line>
          <line x1="3" y1="14" x2="17" y2="14"></line>
        </svg>
      </button>
    </div>
  </div>
  <div id="nav-drawer" class="hidden px-[clamp(16px,4vw,32px)] pb-6" hidden>
    <div class="flex flex-col gap-1 rounded-[16px] border border-ink/10 bg-paper p-3 shadow-lift">
      {links.map((l) => (
        <a href={l.href} class="rounded-[10px] px-4 py-3 font-display text-[17px] font-medium text-ink no-underline hover:bg-paper-2">{l.label}</a>
      ))}
      <a href="/unisciti" class="mt-2 rounded-full bg-mint px-4 py-3 text-center font-display text-[16px] font-medium text-ink no-underline">Iscriviti &rarr;</a>
    </div>
  </div>
</nav>

<style>
  #site-nav.is-floating {
    top: 12px;
    width: calc(100% - 24px);
    max-width: 1200px;
    margin-inline: auto;
    border-radius: 16px;
    background: rgba(247, 242, 236, 0.6);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(14, 24, 48, 0.08);
    box-shadow:
      0 8px 32px -12px rgba(14, 24, 48, 0.18),
      0 1px 0 rgba(255, 255, 255, 0.5) inset;
  }
  #site-nav.is-floating.over-dark {
    background: rgba(14, 24, 48, 0.32);
    border-color: rgba(247, 242, 236, 0.18);
  }
  #site-nav.is-floating.over-dark [data-nav-links] a {
    color: rgba(247, 242, 236, 0.9);
  }
  #site-nav.is-floating.over-dark [data-wordmark] {
    color: var(--color-paper);
  }
  #site-nav.is-floating.over-dark [data-lang] {
    color: rgba(247, 242, 236, 0.75);
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");

  const setDrawer = (open: boolean) => {
    if (!drawer || !toggle) return;
    drawer.classList.toggle("hidden", !open);
    drawer.toggleAttribute("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Chiudi il menu" : "Apri il menu");
    if (nav) nav.classList.add("is-floating");
  };

  toggle?.addEventListener("click", () => {
    const open = drawer?.hasAttribute("hidden") ?? false;
    setDrawer(open);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setDrawer(false);
  });
  drawer?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setDrawer(false)));

  const onScroll = () => {
    if (!nav) return;
    const drawerOpen = drawer && !drawer.hasAttribute("hidden");
    nav.classList.toggle("is-floating", window.scrollY > 24 || !!drawerOpen);
    const dark = document.querySelectorAll("[data-dark]");
    let overDark = false;
    dark.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < 80 && r.bottom > 80) overDark = true;
    });
    nav.classList.toggle("over-dark", overDark && nav.classList.contains("is-floating"));
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
