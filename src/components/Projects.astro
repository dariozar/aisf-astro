---
import Eyebrow from "./Eyebrow.astro";
import Tag from "./Tag.astro";
---

<section id="projects" class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-20">
  <Eyebrow>Progetti</Eyebrow>
  <h2 class="mt-2 font-display text-[clamp(28px,4vw,40px)] font-semibold tracking-[-0.015em]">
    Oltre gli eventi.
  </h2>
  <div class="mt-8 grid grid-cols-1 gap-5 min-[900px]:grid-cols-2">
    <div class="rounded-[22px] bg-tangerine p-8">
      <Tag tone="dark">Rivista</Tag>
      <h3 class="mt-3 font-display text-[24px] font-semibold">Quanta Magazine</h3>
      <p class="mt-2 text-[15px] leading-[1.55] text-ink/80">
        La rivista trimestrale scritta dagli studenti: articoli, interviste e approfondimenti dal mondo della fisica.
      </p>
    </div>
    <div class="rounded-[22px] bg-mint p-8">
      <Tag tone="dark">Divulgazione</Tag>
      <h3 class="mt-3 font-display text-[24px] font-semibold">Fisica nelle scuole</h3>
      <p class="mt-2 text-[15px] leading-[1.55] text-ink/80">
        Laboratori e incontri nelle scuole superiori, portati avanti dai comitati locali in tutta Italia.
      </p>
    </div>
  </div>
</section>
