---
import { getCollection } from "astro:content";
import Tag from "./Tag.astro";
import { Card } from "./starwind/card";

const posts = (await getCollection("news")).slice(0, 3);
---

<section class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-20">
  <Tag>05 &mdash; Dal blog</Tag>
  <h2 class="mt-2 font-display text-[clamp(28px,4vw,40px)] font-semibold tracking-[-0.015em]">Ultime notizie.</h2>
  <div class="mt-8 grid grid-cols-1 gap-5 min-[900px]:grid-cols-3">
    {posts.map((p) => (
      <Card class="border-rule-light bg-paper p-6 transition-transform hover:-translate-y-[3px]">
        <p class="font-mono text-[11px] tracking-[0.08em] text-ink-soft uppercase">{p.data.date}</p>
        <h3 class="mt-2 font-display text-[20px] leading-[1.15] font-semibold">{p.data.title}</h3>
      </Card>
    ))}
  </div>
</section>
