---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import { u } from "../lib/url";

interface Props {
  title?: string;
  lang?: string;
  description?: string;
}

const {
  title = "AISF — Associazione Italiana Studenti di Fisica",
  lang = "it",
  description = "L'Associazione Italiana Studenti di Fisica riunisce gli studenti di fisica in quaranta atenei: eventi, comitati locali, rivista e divulgazione.",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={u("/group-photo.jpg")} />
    <link rel="icon" type="image/png" href={u("/aisf-logo.png")} />
    <link rel="preload" as="image" href={u("/aisf-logo.png")} fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Newsreader:ital,wght@1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteNav />
    <slot />
    <footer class="mt-20 bg-ink text-paper">
      <div class="mx-auto grid max-w-[1200px] gap-6 px-6 py-14 min-[640px]:grid-cols-[37.5%_20.8%_20.8%_20.8%]">
        <div>
          <span class="flex size-11 items-center justify-center overflow-hidden rounded-full bg-paper p-1">
            <img src={u("/aisf-mark.png")} alt="AISF" class="h-full w-auto" />
          </span>
          <p class="mt-5 max-w-[38ch] text-sm text-paper/70">
            Associazione Italiana Studenti di Fisica — rete volontaria di studenti in quaranta atenei italiani.
          </p>
        </div>
        <div>
          <p class="font-mono text-[11px] tracking-[0.14em] text-paper/55 uppercase">Associazione</p>
          <div class="mt-5 flex flex-col gap-3 text-sm">
            <a href={u("/#about")} class="text-paper no-underline">Chi siamo</a>
            <a href={u("/esecutivo")} class="text-paper no-underline">Esecutivo</a>
            <a href={u("/documenti")} class="text-paper no-underline">Documenti</a>
          </div>
        </div>
        <div>
          <p class="font-mono text-[11px] tracking-[0.14em] text-paper/55 uppercase">Attività</p>
          <div class="mt-5 flex flex-col gap-3 text-sm">
            <a href={u("/eventi")} class="text-paper no-underline">Eventi</a>
            <a href={u("/#projects")} class="text-paper no-underline">Progetti</a>
            <a href={u("/comitati")} class="text-paper no-underline">Comitati</a>
          </div>
        </div>
        <div>
          <p class="font-mono text-[11px] tracking-[0.14em] text-paper/55 uppercase">Contatti</p>
          <div class="mt-5 flex flex-col gap-3 text-sm">
            <a href="mailto:info@ai-sf.it" class="text-paper no-underline">info@ai-sf.it</a>
          </div>
        </div>
      </div>
      <div class="border-t border-paper/15">
        <div class="mx-auto flex max-w-[1200px] flex-wrap gap-2 px-6 py-5 font-mono text-[11px] text-paper/55">
          <span>© AISF — Associazione Italiana Studenti di Fisica</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  footer a:hover {
    color: var(--color-tangerine);
  }
</style>
