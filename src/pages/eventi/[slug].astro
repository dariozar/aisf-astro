---
import { getCollection, render } from "astro:content";
import fs from "node:fs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import EventDate from "../../components/EventDate.astro";
import EventType from "../../components/EventType.astro";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((e) => ({ params: { slug: e.id }, props: { event: e } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const cover = event.data.cover?.startsWith("/") && fs.existsSync(`public${event.data.cover}`)
  ? event.data.cover
  : "";
---

<BaseLayout title={`${event.data.title} — AISF`}>
  <main>
    <section data-dark class="relative overflow-hidden rounded-b-[28px] bg-ink text-paper">
      {cover && (
        <img src={cover} alt="" class="absolute inset-0 h-full w-full object-cover" />
      )}
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(14,24,48,0.55) 0%, rgba(14,24,48,0.9) 100%)"></div>
      <div class="relative mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] pt-[140px] pb-16">
        <Tag tone="dark"><EventDate iso={event.data.dateISO} fallback={event.data.date} /></Tag>
        <h1 class="mt-4 max-w-[16ch] font-display font-semibold" style="font-size: clamp(36px, 6vw, 72px); line-height: 1; letter-spacing: -0.02em;">
          {event.data.title}
        </h1>
        <p class="mt-3 font-mono text-[12px] tracking-[0.1em] text-paper/70 uppercase">
          <EventType value={event.data.type} /> · {event.data.location}
        </p>
      </div>
    </section>
    <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-14">
      <article class="prose mx-auto max-w-[780px] rounded-[28px] border border-rule-light bg-paper px-[clamp(20px,4vw,48px)] py-[clamp(28px,4vw,52px)] font-display text-[17px] leading-[1.65] shadow-card">
        <Content />
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(a) { color: var(--color-tangerine-deep); }
  .prose :global(h2) { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.015em; margin: 1.6em 0 0.6em; }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 600; margin: 1.4em 0 0.5em; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em 1.2em; }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(li::marker) { color: var(--color-tangerine-deep); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-family: var(--font-serif); }
  .prose :global(blockquote) { border-left: 4px solid var(--color-tangerine); padding-left: 1em; margin: 0 0 1.2em; color: var(--color-ink-soft); }
  .prose :global(img) { border-radius: 16px; margin: 1.5em auto; }
  .prose :global(hr) { border-color: var(--color-rule-light); margin: 2em 0; }
</style>
