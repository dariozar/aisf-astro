---
import { u } from "../lib/url";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ItalyMap from "../components/ItalyMap.astro";

const committees = await getCollection("committees");
const active = committees.filter((c) => c.data.status !== "frozen");
const frozen = committees.filter((c) => c.data.status === "frozen");
const pin = (c: (typeof committees)[number]) => ({
  id: c.id,
  name: c.data.name,
  status: c.data.status,
  lat: c.data.lat ?? null,
  lon: c.data.lon ?? null,
});
---

<BaseLayout title="Comitati locali — AISF">
  <main>
    <section data-dark class="rounded-b-[28px] bg-ink text-paper">
      <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] pt-[140px] pb-20">
        <Eyebrow dark>Comitati locali</Eyebrow>
        <h1 class="mt-4 font-display font-semibold" style="font-size: clamp(48px, 7vw, 96px); line-height: 0.95; letter-spacing: -0.03em;">
          Una rete,<br /><span class="text-tangerine">in tutta Italia.</span>
        </h1>
        <p class="mt-4 max-w-[56ch] text-[18px] text-paper/70">
          Ogni comitato è gestito da un direttivo di studenti del proprio ateneo.{" "}
          {active.length} attivi oggi — se il tuo ateneo manca, puoi avviarlo tu.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,24px)] py-12">
      <div class="grid grid-cols-1 gap-10 min-[1000px]:grid-cols-[420px_1fr]">
        <div class="min-[1000px]:sticky min-[1000px]:top-24 min-[1000px]:self-start">
          <ItalyMap committees={committees.map(pin)} />
        </div>
        <div>
          <div class="flex flex-col gap-3 min-[800px]:flex-row min-[800px]:items-center">
            <input
              id="lc-search"
              type="search"
              placeholder="Cerca per città o presidente…"
              class="w-full rounded-full border border-rule-light bg-paper px-5 py-3 font-display text-[15px] text-ink outline-none placeholder:text-ink-faint focus:border-tangerine"
            />
            <div class="flex shrink-0 gap-2" role="group" aria-label="Filtra per stato">
              <button type="button" data-lc-filter="all" aria-pressed="true" class="rounded-full bg-ink px-4 py-2.5 font-display text-[14px] font-medium text-paper">Tutti</button>
              <button type="button" data-lc-filter="active" aria-pressed="false" class="rounded-full border border-rule-light bg-paper px-4 py-2.5 font-display text-[14px] font-medium text-ink">Attivi</button>
              <button type="button" data-lc-filter="frozen" aria-pressed="false" class="rounded-full border border-rule-light bg-paper px-4 py-2.5 font-display text-[14px] font-medium text-ink">Sospesi</button>
            </div>
          </div>
          <p id="lc-count" class="mt-4 font-mono text-[12px] tracking-[0.08em] text-ink-soft uppercase" aria-live="polite"></p>

          <div id="lc-list" class="mt-4 flex flex-col gap-2">
            {committees.map((c) => (
              <details
                id={c.id}
                data-committee-card
                data-status={c.data.status}
                data-search={(c.data.name + " " + (c.data.president ?? "")).toLowerCase()}
                class="group rounded-[16px] border border-rule-light bg-paper transition-shadow open:shadow-card"
              >
                <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
                  {c.data.photo ? (
                    <img
                      src={u(c.data.photo)}
                      alt=""
                      loading="lazy"
                      class="size-10 shrink-0 rounded-full object-cover object-[center_top]"
                    />
                  ) : (
                    <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink font-display text-[14px] font-semibold text-paper">
                      {c.data.name.slice(0, 1)}
                    </span>
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-display text-[16px] font-semibold leading-tight">{c.data.name}</span>
                    {c.data.president && (
                      <span class="block truncate text-[13px] text-ink-soft">{c.data.president}</span>
                    )}
                  </span>
                  {c.data.status === "frozen" && (
                    <span class="shrink-0 rounded-full bg-paper-2 px-2.5 py-1 font-mono text-[10px] tracking-[0.08em] text-ink-soft uppercase">Sospeso</span>
                  )}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="shrink-0 text-ink-soft transition-transform group-open:rotate-180">
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </summary>
                <div class="px-4 pb-4 pl-[68px]">
                  {(c.data.founded || c.data.past_presidents) && (
                    <p class="text-[13px] leading-[1.6] text-ink-soft">
                      {c.data.founded && <span class="font-mono text-[11px] tracking-[0.06em] uppercase">{c.data.status === "frozen" ? `Fondato ${c.data.founded}` : `Attivo dal ${c.data.founded}`}</span>}
                      {c.data.founded && c.data.past_presidents && <br />}
                      {c.data.past_presidents && <span>Già presidenti: {c.data.past_presidents}</span>}
                    </p>
                  )}
                  <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-rule-light pt-2.5 font-mono text-[11px]">
                    <button type="button" data-locate={c.id} class="inline-flex items-center gap-1 text-tangerine-deep">
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 14s5-4.6 5-8a5 5 0 1 0-10 0c0 3.4 5 8 5 8z"/><circle cx="8" cy="6" r="1.6"/></svg>
                      Mappa
                    </button>
                    {c.data.email && <a href={`mailto:${c.data.email}`} class="text-tangerine-deep no-underline">{c.data.email}</a>}
                    {c.data.link && <a href={c.data.link} target="_blank" rel="noopener" class="text-ink-soft no-underline">Social &rarr;</a>}
                    {c.data.rules && <a href={c.data.rules} target="_blank" rel="noopener" class="text-ink-soft no-underline">Regolamento &rarr;</a>}
                  </div>
                </div>
              </details>
            ))}
          </div>
          <div id="lc-empty" class="hidden rounded-[16px] bg-paper-2 p-8 text-center">
            <p class="font-display text-[18px] font-medium">Nessun comitato trovato.</p>
            <p class="mt-1 text-[15px] text-ink-soft">Prova a cercare un'altra città.</p>
          </div>

          {frozen.length > 0 && (
            <div class="mt-8 rounded-[22px] bg-paper-2 p-6 text-[14px] text-ink-soft">
              <strong class="font-medium text-ink">Comitati sospesi:</strong>{" "}
              {frozen.map((c) => c.data.name).join(" · ")} — in cerca di nuovi
              referenti per ripartire. Vuoi riavviarne uno?{" "}
              <a href="mailto:info@ai-sf.it" class="text-tangerine-deep no-underline">Scrivici &rarr;</a>
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const q = document.getElementById("lc-search") as HTMLInputElement;
  const count = document.getElementById("lc-count")!;
  const empty = document.getElementById("lc-empty")!;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-committee-card]")];
  const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-lc-filter]")];
  let status = "all";

  function paintFilter() {
    filters.forEach((b) => {
      const on = b.dataset.lcFilter === status;
      b.setAttribute("aria-pressed", String(on));
      b.className = on
        ? "rounded-full bg-ink px-4 py-2.5 font-display text-[14px] font-medium text-paper"
        : "rounded-full border border-rule-light bg-paper px-4 py-2.5 font-display text-[14px] font-medium text-ink";
    });
  }

  function apply() {
    const needle = q.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((c) => {
      const ok =
        (!needle || (c.dataset.search ?? "").includes(needle)) &&
        (status === "all" || c.dataset.status === status);
      c.classList.toggle("hidden", !ok);
      if (ok) visible++;
    });
    count.textContent = `${visible} di ${cards.length} comitati`;
    empty.classList.toggle("hidden", visible > 0);
  }

  q.addEventListener("input", apply);
  filters.forEach((b) =>
    b.addEventListener("click", () => {
      status = b.dataset.lcFilter ?? "all";
      paintFilter();
      apply();
    }),
  );
  paintFilter();
  apply();
</script>
